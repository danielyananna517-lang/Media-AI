function send(res,status,body){
  if (res.headersSent) return;
  const payload = JSON.stringify(body);
  if (Buffer.byteLength(payload, 'utf8') > MAX_RESPONSE) {
    res.writeHead(500,{'content-type':'application/json; charset=utf-8','cache-control':'no-store','x-content-type-options':'nosniff'});
    return res.end(JSON.stringify({status:'error',error:'response_too_large'}));
  }
  res.writeHead(status,{'content-type':'application/json; charset=utf-8','cache-control':'no-store','x-content-type-options':'nosniff'});
  res.end(payload);
}
function sendApiResult(res, status, body, requestId){
  return send(res,status,{request_id:requestId,...body});
}
function sendCsv(res,status,text,requestId){
  if (res.headersSent) return;
  const payload=String(text);
  if (Buffer.byteLength(payload,'utf8') > MAX_RESPONSE) return send(res,500,{status:'error',error:'response_too_large',request_id:requestId});
  res.writeHead(status,{'content-type':'text/csv; charset=utf-8','content-disposition':'attachment; filename=novessa-business-report.csv','cache-control':'no-store','x-content-type-options':'nosniff','x-request-id':requestId});
  res.end(payload);
}
