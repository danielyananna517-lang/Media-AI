    if(u.pathname==='/api/rules/discover-source'){ const out=await discoverRuleSources({id:input.id,query:input.query,count:input.count,provider:input.provider},{env:process.env}); const httpStatus=out.status==='provider_unavailable'?503:out.status==='invalid_data'||out.status==='input_incomplete'?400:out.status==='error'?502:200; return sendApiResult(res,httpStatus,out,requestId); }
    if(u.pathname==='/api/rules/verify-source'){ const out=await verifyDiscoveredRuleSource({id:input.id,url:input.url,discovered_by:input.discovered_by},{env:process.env}); const httpStatus=out.status==='provider_unavailable'?503:out.status==='invalid_data'||out.status==='input_incomplete'?400:out.status==='error'?502:200; return sendApiResult(res,httpStatus,out,requestId); }
    if(u.pathname==='/api/rules/intelligence/scan'){ const out=await scanRuleIntelligence({id:input.id,query:input.query,count:input.count,fetchSources:input.fetch_sources!==false},{env:process.env}); const httpStatus=out.status==='provider_unavailable'?503:out.status==='invalid_data'||out.status==='input_incomplete'?400:out.status==='error'?502:200; return sendApiResult(res,httpStatus,out,requestId); }
    if(u.pathname==='/api/rules/validate') return sendApiResult(res,200,validateRulePack(input.rule_pack||input),requestId);
    if(u.pathname==='/api/rules/observe'){ const out=await ingestRuleObservation(input,{env:process.env}); return sendApiResult(res,out.status==='invalid_data'?400:out.status==='input_incomplete'?400:200,out,requestId); }
    if(u.pathname==='/api/rules/candidate'){ const out=await createRuleCandidate({current_rule_id:input.current_rule_id,proposed:input.proposed,evidence_observation_ids:input.evidence_observation_ids}); return sendApiResult(res,out.status==='invalid_data'?400:200,out,requestId); }
    if(u.pathname==='/api/rules/candidate/structured'){ const out=await createStructuredRuleCandidate({current_rule_id:input.current_rule_id,proposed:input.proposed,evidence_observation_ids:input.evidence_observation_ids,change_case_id:input.change_case_id,affected_algorithms:input.affected_algorithms},{env:process.env}); return sendApiResult(res,out.status==='invalid_data'||out.status==='input_incomplete'?400:200,out,requestId); }
    if(u.pathname==='/api/rules/tests/generate'){ const out=generateRuleTests({current:input.current,candidate:input.candidate}); return sendApiResult(res,out.status==='invalid_data'||out.status==='input_incomplete'?400:200,out,requestId); }
    if(u.pathname==='/api/rules/evaluate-structured'){ const out=evaluateStructuredRuleCandidate({current:input.current,candidate:input.candidate,tests:input.tests}); return sendApiResult(res,out.status==='invalid_data'||out.status==='input_incomplete'?400:200,out,requestId); }
    if(u.pathname==='/api/rules/evaluate'){ const out=await evaluateAndMaybePromoteRule({current:input.current,candidate:input.candidate,impacted_tests:Array.isArray(input.impacted_tests)?input.impacted_tests:[],env:process.env}); return sendApiResult(res,out.status==='invalid_data'?400:200,out,requestId); }
    if(u.pathname==='/api/rules/rollback'){ const out=await rollbackRuleChange(input.rule_id,{env:process.env,reason:String(input.reason||'rule_rollback')}); return sendApiResult(res,out.status==='partial'?409:out.status==='invalid_data'?400:200,out,requestId); }
    if(u.pathname==='/api/import/commerce-snapshot'){ const out=normalizeCommerceSnapshot({connector:input.connector,native:input.native,operation:input.operation}); return sendApiResult(res,out.status==='invalid_data'?400:200,out,requestId); }
    if(u.pathname==='/api/commerce/reconcile'){ const out=reconcileCanonicalCommerce({entities:input.entities,expectedTotals:input.expected_totals,tolerance:input.tolerance}); return sendApiResult(res,out.status==='invalid_data'?400:200,out,requestId); }
    if(u.pathname==='/api/commerce/intelligence'){ const out=input.use_store===true?await analyzeCanonicalStore({env:process.env,expectedTotals:input.expected_totals,tolerance:input.tolerance,includeRecords:input.include_records===true}):analyzeCanonicalCommerce({entities:input.entities,expectedTotals:input.expected_totals,tolerance:input.tolerance,includeRecords:input.include_records===true}); const httpStatus=out.status==='invalid_data'?400:out.status==='input_incomplete'?400:200; return sendApiResult(res,httpStatus,out,requestId); }
    if(u.pathname==='/api/commerce/ingest'){ const out=await ingestCanonicalSnapshot({snapshot:input.snapshot,runId:input.run_id,env:process.env}); return sendApiResult(res,out.status==='invalid_data'||out.status==='input_incomplete'?400:200,out,requestId); }
    if(u.pathname==='/api/commerce/sync'){ const out=await syncCommerceConnector({connector:input.connector,input,connectorFactoryOptions:{env:process.env},persistCanonical:input.persist_canonical===true}); const httpStatus=out.status==='provider_unavailable'?503:out.status==='invalid_data'||out.status==='input_incomplete'?400:out.status==='error'?502:200; return sendApiResult(res,httpStatus,out,requestId); }
    if(u.pathname==='/api/publishing/book/validate'){ const out=validateBook(input); return sendApiResult(res,out.status==='invalid_data'||out.status==='input_incomplete'?400:200,out,requestId); }
    if(u.pathname==='/api/publishing/kdp/package'){ const out=buildKdpPackage(input); return sendApiResult(res,out.status==='invalid_data'||out.status==='input_incomplete'?400:200,out,requestId); }
    if(u.pathname==='/api/publishing/youtube/campaign'){ const out=buildYoutubeCampaign(input); return sendApiResult(res,out.status==='invalid_data'||out.status==='input_incomplete'?400:200,out,requestId); }
    if(u.pathname==='/api/publishing/youtube/channel'){ const out=await youtubeChannel({env:process.env}); return sendApiResult(res,out.status==='provider_unavailable'?503:out.status==='invalid_data'||out.status==='input_incomplete'?400:out.status==='error'?502:200,out,requestId); }
    if(u.pathname==='/api/publishing/youtube/video'){ const out=await youtubeVideo({video_id:input.video_id,env:process.env}); return sendApiResult(res,out.status==='provider_unavailable'?503:out.status==='invalid_data'||out.status==='input_incomplete'?400:out.status==='error'?502:200,out,requestId); }
    if(u.pathname==='/api/publishing/youtube/analytics'){ const out=await youtubeAnalytics({start_date:input.start_date,end_date:input.end_date,metrics:input.metrics,dimensions:input.dimensions,env:process.env}); return sendApiResult(res,out.status==='provider_unavailable'?503:out.status==='invalid_data'||out.status==='input_incomplete'?400:out.status==='error'?502:200,out,requestId); }
    if(u.pathname==='/api/publishing/youtube/upload-session'){ const out=await youtubeUploadSession({metadata:input.metadata,content_type:input.content_type,content_length:input.content_length,env:process.env}); return sendApiResult(res,out.status==='provider_unavailable'?503:out.status==='invalid_data'||out.status==='input_incomplete'?400:out.status==='error'?502:200,out,requestId); }
    if(u.pathname==='/api/evolution/feedback'){
      const result=await submitFeedback({...input,request_id:requestId});
      return sendApiResult(res,result.status==='invalid_data'?400:result.status==='input_incomplete'?400:200,result,requestId);
    }
    if(u.pathname==='/api/evolution/evolve'){
      const result=await evolve({evaluation_records:Array.isArray(input.evaluation_records)?input.evaluation_records:[]});
      if(result.promotion?.active_policy) activeRecommendationPolicy=result.promotion.active_policy;
      else if(result.promotion?.status==='verified' && result.active_policy) activeRecommendationPolicy=result.active_policy;
      return sendApiResult(res,result.status==='invalid_data'?400:result.status==='error'?500:200,result,requestId);
    }
    if(u.pathname==='/api/evolution/rollback'){
      const result=await rollbackEvolution({reason:String(input.reason||'manual_rollback')});
      if(result.active_policy) activeRecommendationPolicy=result.active_policy;
      return sendApiResult(res,result.status==='error'?500:result.status==='partial'?409:200,result,requestId);
    }
    if(u.pathname==='/api/media/request'){
      const result=await requestMedia({operation:input.operation,input:input.input,requestId});
      await recordUsage({operation:u.pathname,status:result.status,request_id:requestId});
      return sendApiResult(res,result.status==='provider_unavailable'?503:result.status==='error'?502:200,result,requestId);
    }
    const fn=routes[u.pathname];
    if(!fn) return send(res,404,{status:'error',error:'not_found'});
    const result=fn(input);
    await recordUsage({operation:u.pathname,status:result.status,request_id:requestId});
    return sendApiResult(res,200,result,requestId);
  }catch(error){
    const code=error.statusCode||500;
    const production=String(process.env.NOVESSA_ENV||'').toLowerCase()==='production';
    if (production && code >= 500) return send(res,500,{status:'error',error:'internal_server_error'});
    return send(res,code,{status:'error',error:String(error.message||error)});
  }
});
server.listen(PORT,()=>console.log(`Novessa Core 0.4.9 listening on ${PORT}`));
