      const a=Buffer.from(supplied),b=Buffer.from(adminToken);
      if(a.length!==b.length||!crypto.timingSafeEqual(a,b)) return send(res,401,{status:'error',error:'admin_auth_required'});
      return send(res,200,await getEvolutionStatus());
    }
    if(req.method==='GET'&&u.pathname==='/ready'){
      const production=String(process.env.NOVESSA_ENV||'').toLowerCase()==='production';
